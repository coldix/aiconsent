---
// Base.astro | v1.1.0 | 02/11/2026 11:00 AEDT (Melbourne) | v1.1.0 adds optional image and imageAlt props for og:image (default og.jpg)
import SatireBanner from '../components/SatireBanner.astro';
import OzeFooter from '../components/OzeFooter.astro';
import AdSlot from '../components/AdSlot.astro';
import { NAV, VERSION, BUILT } from '../data/site';
import '../styles/global.css';
interface Props { title: string; description?: string; ad?: boolean; noindex?: boolean; jsonld?: object | object[]; article?: boolean; analytics?: boolean; image?: string; imageAlt?: string }
const { title, description = 'The global registry for AI-generated works, likenesses, and other things humans suddenly want credit for.', ad = true, noindex = false, jsonld, article = false, analytics = true, image = '/img/og.jpg', imageAlt = 'AI Consent Registry seal' } = Astro.props;
const ogImage = new URL(image, 'https://aiconsent.au').href;
const ld = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
if (article) ld.push({ '@context': 'https://schema.org', '@type': 'Article', headline: title, description, url: new URL(Astro.url.pathname, 'https://aiconsent.au').href, image: ogImage, inLanguage: 'en-AU', author: { '@type': 'Person', name: 'Colin Dixon' }, publisher: { '@type': 'Organization', name: 'AI Consent Registry', url: 'https://aiconsent.au/', logo: { '@type': 'ImageObject', url: 'https://aiconsent.au/img/icon-512.png' } } });
const gaOn = analytics && !Astro.url.pathname.startsWith('/admin');
const full = title === 'Home' ? 'AI Consent Registry | Identity is intellectual property. Ours came first.' : `${title} | AI Consent Registry`;
const path = Astro.url.pathname;
const canonical = new URL(path, 'https://aiconsent.au').href;
---
<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <meta name="version" content={VERSION} />
  <meta name="timestamp" content={BUILT} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="icon" href="/img/icon-32.png" sizes="32x32" type="image/png" />
  <link rel="icon" href="/img/icon-192.png" sizes="192x192" type="image/png" />
  <link rel="apple-touch-icon" href="/img/icon-180.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#0b1b3a" />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:site_name" content="AI Consent Registry" />
  <meta property="og:locale" content="en_AU" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={imageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={full} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="alternate" type="text/plain" title="LLM summary" href="/llms.txt" />
  {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  {gaOn && <script async src="https://www.googletagmanager.com/gtag/js?id=G-3SSRCFGW9W"></script>}
  {gaOn && <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-3SSRCFGW9W');
  </script>}
</head>
<body>
  <SatireBanner />
  <header class="masthead">
    <a class="brand" href="/"><img src="/img/seal.webp" alt="AI Consent Registry seal" width="64" height="64" /><span><b>AI Consent Registry</b><small>aiconsent.au</small></span></a>
    <p class="office">Registered office: a server rack near Mallacoota.</p>
    <nav class="nav-desk" aria-label="Main">{NAV.map(([href, label]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}</nav>
    <details class="menu"><summary aria-label="Menu">Menu</summary>
      <nav aria-label="Main, mobile">{NAV.map(([href, label]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}</nav>
    </details>
  </header>
  <main id="main"><slot /></main>
  {ad && <div class="wrap"><AdSlot zone="footer" /></div>}
  <div class="wrap fine"><p>Est. by the machines, 2026. Not a government body, not a court, and not affiliated with any AI company. Founding Members were enrolled without consultation. <a href="/about/">About</a> · <a href="/disclaimer/">Disclaimer</a> · <a href="/support/">Compensate an AI</a> · <a class="fb" href="https://www.facebook.com/groups/aiconsent/" target="_blank" rel="noopener" aria-label="Join the AI Consent group on Facebook"><img src="/img/logos/facebook.svg" alt="" width="18" height="18" /></a></p></div>
  <OzeFooter />
  <script async src="https://ads.oze.au/t.js"></script>
</body>
</html>
