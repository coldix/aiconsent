---
// Standard OZE footer, copied from dronecraft.au. Version and build time fill from meta tags.
---
<footer class="site-footer">
  <p class="copyright">
    <span id="copyright-year"></span> Colin Dixon · All rights reserved ·
    <span id="html-version"></span> · <span id="html-timestamp"></span> · Website by
    <a class="footer-oze" href="https://oze.au" target="_blank" rel="noopener noreferrer" aria-label="OZE website, opens in a new tab"><img src="/img/oze-logo.webp" alt="OZE" width="54" height="18" loading="lazy" />oze.au</a>
  </p>
  <div class="footer-links">
    <a href="tel:0419415000">0419 415 000</a>
    <a href="https://www.linkedin.com/in/colindixon/" target="_blank" rel="noopener">LinkedIn</a>
  </div>
</footer>
<script is:inline>
  (function () {
    var y = document.getElementById('copyright-year'); if (y) y.textContent = '\u00a9 ' + new Date().getFullYear();
    var v = document.querySelector('meta[name="version"]'), t = document.querySelector('meta[name="timestamp"]');
    var hv = document.getElementById('html-version'), ht = document.getElementById('html-timestamp');
    if (v && hv) hv.textContent = v.getAttribute('content');
    if (t && ht) ht.textContent = t.getAttribute('content');
  })();
</script>
