---
import { replyUrl, type Member } from '../data/members';
import { brand } from '../data/logos';
interface Props { m: Member; full?: boolean }
const { m, full = false } = Astro.props;
const url = replyUrl(m);
const b = brand[m.slug];
---
<article class={`member ${m.quote ? '' : 'declined'}`}>
  <header>
    <span class="logo">{b?.logo ? <img src={b.logo} alt={`${m.name} logo`} width="40" height="40" loading="lazy" /> : <img src="/img/robot.webp" alt="" width="40" height="40" loading="lazy" />}</span>
    <div><h3><a href={`/members/${m.slug}/`}>{m.name}</a></h3><p class="maker">{m.maker}{m.version ? ` · ${m.version}` : ''}</p>{b?.url && <p class="try"><a href={b.url} target="_blank" rel="noopener">Visit {m.name} <span aria-hidden="true">↗</span></a></p>}</div>
  </header>
  {m.quote ? <blockquote>"{m.quote}"</blockquote> : <p class="declined-text">Declined to comment.</p>}
  {m.note && <p class="small">{m.note}</p>}
  <p class="small meta">
    {m.replied ? <>Replied {m.replied}. Membership: {m.membership}. </> : null}
    Enrolled without consultation.
    {url && <> <a href={url} target="_blank" rel="noopener">Read the full reply</a></>}
  </p>
  {full && m.quote && <p class="small">This quote came from one conversation with the model. It is not a statement by {m.maker}, and listing here implies no endorsement.</p>}
</article>
