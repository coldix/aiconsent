{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aiconsent-au",
  "account_id": "ab29454df8dbb469d259956fcf482075",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  // Live on aiconsent.au since 01/11/2026 (Colin's OK). workers.dev preview kept on for now.
  "workers_dev": true,
  "routes": [
    { "pattern": "aiconsent.au", "custom_domain": true },
    { "pattern": "www.aiconsent.au", "custom_domain": true }
  ],
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "aiconsent", "database_id": "cf9902eb-a79c-4a35-b170-64f05bf2ce97", "migrations_dir": "migrations" }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFuk_TmP7imiAoqq",
        "DONATE_URL": "https://buy.stripe.com/aFaaEX5tk9f42wx0KZ77O0h",
    // Same Stripe links as lovemallacoota.au (merchant shows as Love Mallacoota)
    "DONATE_URL_10": "https://buy.stripe.com/dRmbJ10900Iy8UV8dr77O0d",
    "DONATE_URL_20": "https://buy.stripe.com/eVq14ncVMgHwfjj9hv77O0e",
    "DONATE_URL_50": "https://buy.stripe.com/28E5kDf3Uezo1st51f77O0f",
    "DONATE_URL_100": "https://buy.stripe.com/cNieVdaNE1MC7QR65j77O0g",
    // Cloudflare Access app "aiconsent admin" (One-time PIN, col@oze.com.au only)
    "ACCESS_TEAM_DOMAIN": "https://quiet-tooth-f3e9.cloudflareaccess.com",
    "ACCESS_AUD": "ca15db6ff5a29bbcf3d437576790bfad9dd1d716204aa886ecc58dcc6c42bc78",
    "ADMIN_EMAILS": "col@oze.com.au"
  },
  // Secrets (set with wrangler secret put, never committed): TURNSTILE_SECRET, VOTE_SALT
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
